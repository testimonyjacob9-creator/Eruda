# Netlify → Site configuration → Environment variables
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SECRET=any-long-random-string        # optional
BREVO_API_KEY=xkeysib-your-key
SENDER_EMAIL=you@yourdomain.com            # verified sender in Brevo
SENDER_NAME=Erudite Easy Pay               # optional
ALLOWED_ORIGIN=https://your-site.netlify.app  # optional (welcome/receipt emails)
VAPID_PRIVATE_KEY=<private key, see below>
PAYSTACK_SECRET_KEY=sk_live_xxx   # Paystack → Settings → API Keys & Webhooks
